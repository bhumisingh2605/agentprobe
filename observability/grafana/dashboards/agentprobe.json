{
  "uid": "agentprobe",
  "title": "AgentProbe",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Runs by status (per hour)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (status) (increase(agentprobe_runs_total[1h]))", "legendFormat": "{{status}}" }]
    },
    {
      "id": 2, "type": "stat", "title": "Scenario pass ratio (1h)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(increase(agentprobe_scenarios_total{result=\"pass\"}[1h])) / sum(increase(agentprobe_scenarios_total[1h]))" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Agent latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(agentprobe_agent_latency_seconds_bucket[5m])))", "legendFormat": "p95" }]
    },
    {
      "id": 4, "type": "timeseries", "title": "Judge latency (average)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "rate(agentprobe_judge_latency_seconds_sum[5m]) / rate(agentprobe_judge_latency_seconds_count[5m])", "legendFormat": "avg" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Estimated tokens per minute",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(agentprobe_tokens_total[5m])) * 60", "legendFormat": "all" },
        { "refId": "B", "expr": "sum(rate(agentprobe_judge_tokens_total[5m])) * 60", "legendFormat": "judge" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Infrastructure failures and judge verdicts",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(agentprobe_infra_failures_total[1h]))", "legendFormat": "infra failures" },
        { "refId": "B", "expr": "sum by (passed) (increase(agentprobe_judge_calls_total[1h]))", "legendFormat": "judge passed={{passed}}" }
      ]
    }
  ]
}